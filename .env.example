[TEMPLATE]
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NASA_API_KEY: Optional API key from https://api.nasa.gov/ for higher DONKI rate limits.
# Defaults to DEMO_KEY on the server if omitted. DEMO_KEY allows about 30 requests
# per hour and 50 per day per IP, which is not enough for a demo: get a free key.
NASA_API_KEY="DEMO_KEY"

# NASA_FETCH_TIMEOUT_MS: Upstream NASA request timeout (milliseconds, 1000-30000).
NASA_FETCH_TIMEOUT_MS="8000"

# NASA_SNAPSHOT_DIR: Where the once-per-UTC-day snapshot is cached on disk.
# Leave empty to disable disk persistence (memory only). Added to .gitignore.
NASA_SNAPSHOT_DIR="./data/nasa"

# RADLAB_WINDOW_START / RADLAB_WINDOW_END: The fixed, real ISS DosTel recording
# window returned by /api/nasa/radlab. Format YYYY-MM-DDTHH:mm (UTC).
RADLAB_WINDOW_START="2022-04-01T23:00"
RADLAB_WINDOW_END="2022-04-02T01:05"

# PORT: HTTP port for the combined Express + Vite server.
PORT="3000"

# NODE_ENV: development (Vite middleware) or production (serve dist/).
NODE_ENV="development"

# DATA_DIR: Directory for the SQLite database (silica.db, WAL files).
DATA_DIR="./data"

# CORS_ORIGINS: Optional comma-separated allow-list. Leave empty for same-origin only.
CORS_ORIGINS=""

# TRUST_PROXY: false (default), true (one proxy hop), or a hop count.
TRUST_PROXY="false"

# RETENTION_DAYS: Anonymous runs older than this are deleted by the daily sweep.
RETENTION_DAYS="365"

# ADMIN_TOKEN: Optional bearer token for GET /api/admin/export.csv. Unset disables the route.
ADMIN_TOKEN=""

# LOG_LEVEL: debug, info, warn, error or silent.
LOG_LEVEL="info"

# DATABASE_URL: P2 only. Postgres store is not implemented; SQLite is used and a warning is logged.
DATABASE_URL=""
